{
  "version": 2,
  "name": "scratchssenger",
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "msngrv11.html",
      "use": "@vercel/static"
    },
    {
      "src": "msngrv12.html",
      "use": "@vercel/static"
    },
    {
      "src": "msngrv13.html",
      "use": "@vercel/static"
    },
    {
      "src": "msngrv144.html",
      "use": "@vercel/static"
    },
    {
      "src": "desktop.html",
      "use": "@vercel/static"
    },
    {
      "src": "web.html",
      "use": "@vercel/static"
    },
    {
      "src": "ICON.jpeg",
      "use": "@vercel/static"
    },
    {
      "src": "internaldl.html",
      "use": "@vercel/static"
    },
    {
      "src": "web-client.html",
      "use": "@vercel/static"
    },
    {
      "src": "js/web-client/main.js",
      "use": "@vercel/static"
    },
    {
      "src": "js/web-client/render.js",
      "use": "@vercel/static"
    },
    {
      "src": "js/metadata.js",
      "use": "@vercel/static"
    },
    {
      "src": "js/web-client/App.js",
      "use": "@vercel/static"
    },
    {
      "src": "js/web-client/polling.js",
      "use": "@vercel/static"
    },
    {
      "src": "js/web-client/ui-components.js",
      "use": "@vercel/static"
    },
    {
      "src": "js/web-client/translations.js",
      "use": "@vercel/static"
    },
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/desktop.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/",
      "dest": "/index.html"
    },
    {
      "src": "/index.html",
      "dest": "/index.html"
    },
    {
      "src": "/index",
      "dest": "/index.html"
    },
    {
      "src": "/msngrv11.html",
      "dest": "/msngrv11.html"
    },
    {
      "src": "/msngrv12.html",
      "dest": "/msngrv12.html"
    },
    {
      "src": "/msngrv13.html",
      "dest": "/msngrv13.html"
    },
    {
      "src": "/msngrv144.html",
      "dest": "/msngrv144.html"
    },
    {
      "src": "/desktop.html",
      "dest": "/desktop.html"
    },
        {
      "src": "/web.html",
      "dest": "/web.html"
    },
    {
      "src": "/ICON.jpeg",
      "dest": "/ICON.jpeg"
    },
    {
      "src": "/internaldl.html",
      "dest": "/internaldl.html"
    },
    {
      "src": "/web-client.html",
      "dest": "/web-client.html"
    },
    {
      "src": "/js/web-client/main.js",
      "dest": "/js/web-client/main.js"
    },
    {
      "src": "/js/web-client/render.js",
      "dest": "/js/web-client/render.js"
    },
    {
      "src": "/js/metadata.js",
      "dest": "/js/metadata.js"
    },
    {
      "src": "/js/web-client/App.js",
      "dest": "/js/web-client/App.js"
    },
    {
      "src": "/js/web-client/polling.js",
      "dest": "/js/web-client/polling.js"
    },
    {
      "src": "/js/web-client/ui-components.js",
      "dest": "/js/web-client/ui-components.js"
    },
    {
      "src": "/js/web-client/translations.js",
      "dest": "/js/web-client/translations.js"
    },
    {
      "src": "/api/",
      "dest": "/api/index.js"
    },
    {
      "src": "/desktop/(.*)",
      "dest": "/api/desktop.js?path=$1"
    }
  ]
}
